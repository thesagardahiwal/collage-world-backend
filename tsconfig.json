{
  "compilerOptions": {
    "target": "es6",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "baseUrl": "./",
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "paths": {
      "src/*": ["./src/*"]
    },
  },
  "include": ["src/**/*.ts", "src/types/*", "src/seed.ts"],
  "exclude": ["node_modules"]
}